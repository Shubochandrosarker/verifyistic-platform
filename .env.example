# Verifyistic platform — example environment file.
# Copy to .env (self-hosted/local dev) and fill in real values.
# NEVER commit a real .env. Production secrets are injected at runtime (doc 06 §10).

# --- Deployment mode: cloud | self_hosted ---
VERIFYISTIC_MODE=cloud

# --- Database (self-hosted) ---
# Cloud uses the bound D1 binding; no connection string needed.
DATABASE_PATH=./local/dev.db

# --- Local dev server ---
PORT=8787

# --- Object storage (self-hosted: local | s3 | r2 | minio) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/var/lib/verifyistic/documents
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth (self-hosted local accounts) ---
# Generate with: openssl rand -base64 48
SESSION_SECRET=
AUTH_MFA_REQUIRED=false

# --- WPistic identity (cloud) ---
WPISTIC_OIDC_ISSUER=
WPISTIC_OIDC_CLIENT_ID=
WPISTIC_OIDC_CLIENT_SECRET=

# --- License public key (self-hosted) — public key only, never the private signing key ---
LICENSE_PUBLIC_KEY=

# --- Email ---
EMAIL_PROVIDER=
EMAIL_API_KEY=

# --- Observability ---
LOG_LEVEL=info
